# --- Database ---
# Postgres connection string. Free tier options: Supabase, Neon, Railway, or your own server's Postgres.
DATABASE_URL=postgres://user:password@localhost:5432/nhealth

# --- Gupshup WhatsApp Business API ---
# Sign up at https://www.gupshup.io -> create a WhatsApp app -> get these from the dashboard.
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_APP_NAME=Nhealth
GUPSHUP_SOURCE_NUMBER=919959461095
# Set this same value in Gupshup's inbound webhook config, as a shared secret check (optional but recommended).
GUPSHUP_WEBHOOK_SECRET=nhealth_secret_2026

# --- Groq (LLM for parsing free-text WhatsApp replies) ---
# Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Business numbers ---
OWNER_WHATSAPP_NUMBER=919959461095

# --- Server ---
PORT=3000
# Base URL where this server is publicly reachable (needed for Gupshup webhook + media links)
PUBLIC_BASE_URL=https://your-domain-or-server.example.com

# How long a request stays open for doctors/technicians to accept before it's flagged to the owner (minutes)
ACCEPT_WINDOW_MINUTES=10
